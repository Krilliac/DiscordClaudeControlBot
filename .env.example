# Copy to .env and fill in real values. .env is gitignored.

# Discord bot token: always required.
DISCORD_BOT_TOKEN=replace-me

# Anthropic API key: OPTIONAL. Two ways to authenticate the agent:
#   1. Set ANTHROPIC_API_KEY here  ->  pay-per-token via the Anthropic API.
#   2. Leave it unset and run `claude /login` once on the PC  ->  bot uses
#      your Claude Pro/Max subscription, no API charges.
# ANTHROPIC_API_KEY=sk-ant-replace-me

# Discord incoming webhook URL for the external watchdog.
# Create one in your Discord alerts channel:
#   Channel settings -> Integrations -> Webhooks -> New Webhook
# The watchdog posts here when the bot's heartbeat goes stale. This is a
# SEPARATE credential from DISCORD_BOT_TOKEN -- if the bot token is reset,
# the watchdog can still reach you.
# Required only if you install the watchdog (task_install_watchdog.ps1).
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
